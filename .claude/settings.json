{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm uninstall *)",
      "Bash(pnpm un *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm upgrade *)",
      "Edit(/package.json)",
      "Edit(/pnpm-lock.yaml)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/.github/workflows/**)"
    ]
  }
}
